    "@fvh/adapter-opencode": "workspace:*",
    "@fvh/application": "workspace:*",
    "@fvh/contracts": "workspace:*",
    "@fvh/domain": "workspace:*",
    "@fvh/knowledge": "workspace:*",
    "@fvh/persistence": "workspace:*",
    "zod": "latest"
  },
  "devDependencies": { "tsx": "latest" }
}
