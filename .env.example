# LinkedIn OAuth credentials (server only; do not add a VITE_ prefix).
FVH_LINKEDIN_CLIENT_ID=
FVH_LINKEDIN_CLIENT_SECRET=

# Freelancer.com read-only API token (server only; do not add a VITE_ prefix).
FVH_FREELANCER_ACCESS_TOKEN=

# Hermes Agent drafting. Consent stays off until the user explicitly enables it.
FVH_AI_MODE=hermes
FVH_AI_DATA_CONSENT=false
FVH_HERMES_BIN=hermes
FVH_HERMES_PROFILE=private-ai-house
