# LinkedIn OAuth credentials (server only; do not add a VITE_ prefix).
FVH_LINKEDIN_CLIENT_ID=
FVH_LINKEDIN_CLIENT_SECRET=

# Freelancer.com production OAuth token for account reads and explicitly confirmed live writes.
# Keep server-only; do not add a VITE_ prefix. Never use this token for sandbox calls.
FVH_FREELANCER_ACCESS_TOKEN=

# Dedicated Freelancer sandbox OAuth token for explicit write capability checks only.
# The sandbox check adapter always targets freelancer-sandbox.com and never uses the production token above.
FVH_FREELANCER_SANDBOX_ACCESS_TOKEN=

# Hermes Agent drafting. Consent stays off until the user explicitly enables it.
FVH_AI_MODE=hermes
FVH_AI_DATA_CONSENT=false
FVH_HERMES_BIN=hermes
FVH_HERMES_PROFILE=private-ai-house

# GitHub token for read-only sync of a selected repository; keep server-only.
GITHUB_TOKEN=

# Supabase Postgres (Dashboard > Connect > Session pooler, port 5432). Server-only; contains the DB password.
DATABASE_URL=
